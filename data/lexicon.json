  "rules": [
    {
      "id": "fz-urgent-payment",
      "patternId": "pay-urgency",
      "severity": 5,
      "all": ["URGENCY", "PAY"],
      "title": { "ko": "지금 당장 입금하라는 압박", "en": "Pressure to pay right now" }
    },
    {
      "id": "fz-hold-room-payment",
      "patternId": "pay-urgency",
      "severity": 5,
      "all": ["PAY", "HOLD_ROOM"],
      "title": { "ko": "돈을 보내면 방을 잡아준다는 제안", "en": "Pay and we'll hold the room" }
    },
    {
      "id": "fz-competition-pressure",
      "patternId": "pay-urgency",
      "severity": 4,
      "all": ["COMPETITION", "URGENCY"],
      "title": { "ko": "다른 사람이 계약한다는 압박", "en": "Someone else is about to take it" }
    },
    {
      "id": "fz-third-party-account",
      "patternId": "pay-personal-account",
      "severity": 5,
      "all": ["ACCOUNT", "THIRD_PARTY"],
      "title": { "ko": "소유자 아닌 사람의 계좌로 송금 요구", "en": "Transfer to someone else's account" }
    },
    {
      "id": "fz-owner-absent-proxy",
      "patternId": "id-proxy-no-poa",
      "severity": 5,
      "all": ["OWNER", "ABSENT"],
      "any": ["PROXY", "PAY", "CONTRACT_DOC"],
      "title": { "ko": "집주인 부재를 이유로 한 대리 계약", "en": "Owner is away, so a proxy signs" }
    },
    {
      "id": "fz-refuse-register",
      "patternId": "id-refuse-register",
      "severity": 5,
      "all": ["REGISTER_DOC", "REFUSE"],
      "title": { "ko": "등기부등본 확인 회피", "en": "Avoiding the property register" }
    },
    {
      "id": "fz-delay-movein",
      "patternId": "con-no-moving-report",
      "severity": 5,
      "all": ["MOVEIN_REPORT", "DELAY"],
      "none": ["MUST_DO"],
      "title": { "ko": "전입신고·확정일자를 미루라는 요구", "en": "Asked to delay the move-in report" }
    },
    {
      "id": "fz-mortgage-reassure",
      "patternId": "reg-heavy-mortgage",
      "severity": 5,
      "all": ["MORTGAGE", "REASSURE"],
      "title": { "ko": "근저당이 있지만 괜찮다는 설명", "en": "There's a mortgage but it's fine" }
    },
    {
      "id": "fz-trust-reassure",
      "patternId": "reg-trust",
      "severity": 5,
      "all": ["TRUST_CO"],
      "any": ["REASSURE", "OWNER", "CONTRACT_DOC"],
      "title": { "ko": "신탁 부동산인데 문제없다는 설명", "en": "Property is in trust but 'no problem'" }
    },
    {
      "id": "fz-seizure-reassure",
      "patternId": "reg-seizure-auction",
      "severity": 5,
      "all": ["SEIZURE", "REASSURE"],
      "title": { "ko": "압류·경매가 있지만 괜찮다는 설명", "en": "Seizure or auction dismissed as fine" }
    },
    {
      "id": "fz-no-visit",
      "patternId": "good-remote-keys",
      "severity": 5,
      "all": ["NO_VISIT"],
      "any": ["PAY", "CONTRACT_DOC", "KEYS_REMOTE"],
      "title": { "ko": "방을 보지 않고 계약·입금 유도", "en": "Contract or payment without a viewing" }
    },
    {
      "id": "fz-keys-by-mail",
      "patternId": "good-remote-keys",
      "severity": 5,
      "all": ["KEYS_REMOTE"],
      "any": ["NO_VISIT", "PAY"],
      "title": { "ko": "열쇠를 택배로 보낸다는 제안", "en": "Keys to be sent by mail" }
    },
    {
      "id": "fz-cash-no-receipt",
      "patternId": "pay-cash-no-receipt",
      "severity": 4,
      "all": ["CASH"],
      "any": ["PAY", "NO_RECEIPT", "CHEAP"],
      "title": { "ko": "현금 결제 유도", "en": "Pushed toward a cash payment" }
    },
    {
      "id": "fz-verbal-only",
      "patternId": "con-verbal-only",
      "severity": 4,
      "all": ["CONTRACT_DOC", "VERBAL"],
      "title": { "ko": "약속을 계약서에 적지 않으려 함", "en": "Promises kept out of the contract" }
    },
    {
      "id": "fz-no-refund",
      "patternId": "gosi-no-refund",
      "severity": 4,
      "all": ["REFUND", "IMPOSSIBLE"],
      "title": { "ko": "환불 불가 조건", "en": "No-refund terms" }
    },
    {
      "id": "fz-no-business-reg",
      "patternId": "gosi-no-business-reg",
      "severity": 4,
      "all": ["BUSINESS_REG", "ABSENT_DOC"],
      "title": { "ko": "사업자등록이 없다는 답변", "en": "No business registration" }
    },
    {
      "id": "fz-too-cheap",
      "patternId": "good-too-cheap",
      "severity": 4,
      "all": ["CHEAP"],
      "any": ["URGENCY", "PAY", "HOLD_ROOM"],
      "title": { "ko": "비정상적으로 싼 조건 + 결정 압박", "en": "Unusually cheap, decide now" }
    }
  ]
}
